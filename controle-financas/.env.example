# Copie para .env e preencha. NUNCA faça commit do .env.

# Provedor de dados: "pluggy" (Open Finance real) ou "fake" (dados de teste)
FINANCAS_PROVEDOR=fake

# Credenciais da aplicação no dashboard da Pluggy (https://dashboard.pluggy.ai)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# IDs dos "items" (conexões bancárias) separados por vírgula
PLUGGY_ITEM_IDS=

# Caminho do banco SQLite local
FINANCAS_DB=financas.db

# Dias para buscar na primeira sincronização
FINANCAS_DIAS_INICIAIS=365
