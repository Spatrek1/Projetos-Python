__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
tempCodeRunnerFile.py

# Base bruta do IF.data: reproduzivel a partir da fonte, nao versionada.
dados/ifdata_bruto/*
!dados/ifdata_bruto/.gitkeep
