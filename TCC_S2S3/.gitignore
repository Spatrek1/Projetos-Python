# Saidas do processamento: geradas por processar_base.py.
dados/tratados/*
!dados/tratados/.gitkeep
resultados/*
!resultados/.gitkeep

# Dados externos fornecidos pelo pesquisador.
dados/externos/*.csv
!dados/externos/eventos_publicos_MODELO.csv
